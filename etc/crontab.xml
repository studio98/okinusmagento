<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/crontab.xsd">
    <group id="default">
        <job name="okinus_payment_process_webhook_events" instance="Okinus\Payment\Cron\ProcessWebhookEvents" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="okinus_payment_renew_webhook_subscription" instance="Okinus\Payment\Cron\RenewWebhookSubscription" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
    </group>
</config>
