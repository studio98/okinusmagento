<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="checkout_submit_all_after">
        <observer name="OrderConfirmed" instance="Okinus\Payment\Observer\OrderConfirmed" />
    </event>
    <event name="sales_order_save_commit_after">
        <observer name="OrderCompleted" instance="Okinus\Payment\Observer\OrderCompleted" />
    </event>

    <event name="payment_method_is_active">
        <observer name="PaymentMethodAvailable" instance="Okinus\Payment\Observer\PaymentMethodAvailable" />
    </event>

</config>
